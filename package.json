{
  "name": "nestjs-api",
  "version": "0.0.1",
  "description": "Open Source NodeJS Project w/ TypeScript & NestJS",
  "author": "3angleTech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:3angleTech/nestJsApi.git"
  },
  "bugs": {
    "url": "https://github.com/3angleTech/nestJsApi/issues"
  },
  "homepage": "https://github.com/3angleTech/nestJsApi#readme",
  "main": "src/main.ts",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint -c .eslintrc.js \"{src,db,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "build:api-client": "openapi-generator-cli generate -i http://localhost:3000/api/v1/docs-json -g typescript-axios -o ./libs/api-client",
    "test:e2e": "jest --config ./test/jest-e2e.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:create": "npm run typeorm migration:create",
    "migration:run": "npm run typeorm -- -d typeormconfig.ts migration:run -t=false",
    "migration:revert": "npm run typeorm -- -d typeormconfig.ts migration:revert",
    "run-migrations-and-start": "npm run migration:run && npm run start:prod"
  },
  "dependencies": {
    "@nestjs/common": "11.1.13",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.13",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@sendgrid/mail": "8.1.6",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@3angletech/eslint-config": "19.0.0",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/testing": "11.1.13",
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.2.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "jest": "30.2.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "lodash": "^4.17.23"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
